{
  "name": "ever-inkwell",
  "version": "0.2.0",
  "description": "EVER (Evolving Virtual Experiences & Reincarnation): a low-poly 3D village and a card combat built on Slay the Web, solo or co-op.",
  "type": "module",
  "license": "AGPL-3.0-or-later",
  "private": true,
  "engines": {
    "node": ">=20.19"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "test": "vitest run && node test/smoke.mjs",
    "test:unit": "vitest run",
    "test:bridge": "node test/smoke.mjs",
    "rooms": "wrangler dev --config server/wrangler.toml --port 8787",
    "start": "node bridge.mjs",
    "test:rooms": "node server/test/rooms-integration.mjs"
  },
  "dependencies": {
    "immer": "^10.2.0",
    "three": "^0.170.0"
  },
  "devDependencies": {
    "vite": "^7.3.7",
    "vitest": "^3.2.7",
    "wrangler": "^4.156.0"
  }
}
